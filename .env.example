# Optional LLM API keys (Leave blank to use local heuristic/offline grounded generation and LLM judge fallback)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Kaggle credentials (only needed if downloading private datasets; customer-support-on-twitter is public)
# KAGGLE_USERNAME=
# KAGGLE_KEY=

# Pipeline configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
RANDOM_SEED=42
